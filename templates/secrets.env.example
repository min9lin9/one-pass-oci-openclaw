# Store OUTSIDE Git: ~/.config/oracle-ai-stack/secrets.env (0600; parent 0700).
# Literal KEY=value; quote spaces. No shell expansion is executed.
DOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DNS01_TOKEN=
TAILSCALE_AUTH_KEY=

# OCI API signing identity (NOT SSH identity). Existing API signing key registered in OCI.
OCI_USER=
OCI_FINGERPRINT=
OCI_TENANCY=
OCI_REGION=
OCI_KEY_FILE=
# Optional API key passphrase. Never transmitted to the instance.
OCI_KEY_PASSPHRASE=
# Empty uses tenancy compartment; requires authorized compute/network permissions.
OCI_COMPARTMENT=
# Auto-discovers tenancy home-region AD + official Ubuntu 24.04 ARM image.
OCI_AD=
OCI_IMAGE=
# Either existing public subnet or create a dedicated VCN/subnet automatically.
OCI_SUBNET=
# Leave empty to derive from OCI_SUBNET. Set true or false only for explicit selection.
OCI_CREATE_NETWORK=
# REQUIRED for newly created network: your current public IPv4 CIDR, ideally /32.
# Do not use 0.0.0.0/0 or a LAN/Tailscale IP. Example shape: <PUBLIC_IPV4>/32.
OCI_SSH_ALLOWED_CIDR=
OCI_INSTANCE_NAME=oracle-ai-stack
OCI_BOOT_VOLUME_GB=50
OCI_MAX_ATTEMPTS=3
# 2 OCPU/12 GiB is fixed. No larger/paid shape or region fallback.

# Empty -> create VM and securely generate/reuse a local SSH key and OCID handoff.
# Existing managed v0.3 VM -> these may be specified; no OCI permissions then needed.
ORACLE_HOST=
ORACLE_SSH_USER=ubuntu
ORACLE_SSH_KEY=
SSH_PORT=22
SSH_KNOWN_HOSTS=

# Existing Go/Zen API key. Enabling an API-key profile authorizes small model probes.
OPENCODE_API_KEY=
OPENCODE_CATALOG=go
# chatgpt | opencode-go | opencode
OPERATIONS_AUTH=chatgpt
# Empty -> OpenCode if key present, otherwise ChatGPT. No hidden cross-provider fallback.
PLANNING_AUTH=
DEVELOPMENT_AUTH=
# Optional explicit provider/model ref, checked against live catalog before selection.
OPERATIONS_MODEL=
PLANNING_MODEL=
DEVELOPMENT_MODEL=

# Set when Buzz owner creates/chooses the room. Only operations gets the bot identity.
BUZZ_ROOM_ID=
BUZZ_OWNER_PUBKEY=
# Do not put ChatGPT passwords/access/refresh tokens here. Use profile-scoped OAuth.
